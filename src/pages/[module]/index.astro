---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE, MODULES, STATUS_LABEL, STATUS_CLASS, url } from '../../consts';
import illuTravel from '../../assets/illustrations/illu-travel.jpg';
import illuAiLab from '../../assets/illustrations/illu-ai-lab.jpg';
import illuMath from '../../assets/illustrations/illu-math.jpg';
import illuReading from '../../assets/illustrations/illu-reading.jpg';
import illuMusic from '../../assets/illustrations/illu-music.jpg';

export function getStaticPaths() {
  return MODULES.map((m) => ({ params: { module: m.slug }, props: { m } }));
}

const { m } = Astro.props;

const ILLUS: Record<string, ImageMetadata> = {
  'illu-travel': illuTravel,
  'illu-ai-lab': illuAiLab,
  'illu-math': illuMath,
  'illu-reading': illuReading,
  'illu-music': illuMusic,
};

const posts = (await getCollection('posts', ({ data }) => !data.draft && data.module === m.slug)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const fmt = (d: Date) => d.toISOString().slice(0, 10);
---

<BaseLayout title={m.name} description={m.desc}>
  <section class="page-hero">
    <div class="wrap page-hero-grid">
      <div>
        <div class="hero-kicker"><span class="dot"></span>{m.no} · {m.prefix} · 馆藏分区</div>
        <h1 class="page-title">{m.name}<span class="page-title-en">{m.en}</span></h1>
        <p class="page-desc">{m.desc}</p>
        <div class="page-meta">
          <span>本区标本 <b>{posts.length} 件</b></span>
          <span>前缀 <b>{m.prefix}</b></span>
        </div>
      </div>
      <figure class="page-fig">
        <Image src={ILLUS[m.illu]} alt={`${m.name} · 插图`} class={m.fitContain ? 'fit-c' : undefined} widths={[480, 800]} sizes="(max-width: 720px) 100vw, 38vw" />
        <figcaption><span>{m.prefix} · 分区图鉴</span><span>手绘水彩</span></figcaption>
      </figure>
    </div>
  </section>

  <section class="list-section">
    <div class="wrap">
      <div class="list-head">
        <h1>标本列表<span class="en">SPECIMENS</span></h1>
        <div class="count">{String(posts.length).padStart(2, '0')} 件</div>
      </div>

      {posts.length === 0 ? (
        <p class="empty-note">本区标本采集中，暂无已发布内容。</p>
      ) : (
        posts.map((p) => (
          <article class="entry">
            <div class="rs">
              {p.data.specimen}
              <span class="kind">{m.name}</span>
            </div>
            <div>
              <h4><a href={url(`/${m.slug}/${p.id}`)}>{p.data.title}</a></h4>
              <p class="excerpt">{p.data.description}</p>
              {p.data.tags.length > 0 && (
                <div class="tags">{p.data.tags.map((t) => <span class="tag">{t}</span>)}</div>
              )}
            </div>
            <div class="meta">
              <span class={`badge ${STATUS_CLASS[p.data.status]}`}>{STATUS_LABEL[p.data.status]}</span>
              <br />{fmt(p.data.date)}
            </div>
          </article>
        ))
      )}
    </div>
  </section>
</BaseLayout>
