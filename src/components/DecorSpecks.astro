---
// 方案 D · 落墨微粒
// 细碎小点以不同速度缓慢上浮并淡出，像标本室里浮动的尘埃 / 培养皿里的孢子。
// 纯 CSS，无 JS、无外部依赖；尊重 prefers-reduced-motion。
const SPECK_COUNT = 26;
const specks = Array.from({ length: SPECK_COUNT }, (_, i) => {
  const x = (i * 37 + 11) % 100;
  const s = 1 + ((i * 13) % 3) * 0.6;
  const dur = 9 + ((i * 7) % 9);
  const delay = -((i * 3.7) % dur);
  const drift = ((i % 2 === 0) ? 1 : -1) * (6 + (i % 5) * 3);
  const accent = i % 9 === 4;
  return { x, s, dur, delay, drift, accent };
});
---
<div class="d-specks" aria-hidden="true">
  {specks.map((p) => (
    <span
      class="speck"
      style={`--x:${p.x}%; --s:${p.s}px; --dur:${p.dur}s; --delay:${p.delay.toFixed(1)}s; --drift:${p.drift}px; ${p.accent ? '--c:var(--accent, #c2452d);' : ''}`}
    ></span>
  ))}
</div>

<style>
  .d-specks { position: relative; width: 100%; height: 100%; overflow: hidden; }
  .speck {
    position: absolute; bottom: -6px; left: var(--x);
    width: var(--s); height: var(--s); border-radius: 50%;
    background: var(--c, var(--ink-faint, #9a9184));
    opacity: 0;
    animation: speckRise var(--dur) linear infinite;
    animation-delay: var(--delay);
  }
  @keyframes speckRise {
    0%   { transform: translate(0, 0);        opacity: 0; }
    14%  { opacity: .55; }
    70%  { opacity: .4; }
    100% { transform: translate(var(--drift), -230px); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .speck { animation: none; opacity: .3; }
  }
</style>
