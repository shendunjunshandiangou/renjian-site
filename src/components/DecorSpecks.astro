---
// 方案 D · 落墨微粒（可见度增强版）
// 细碎小点缓慢上浮淡出，像标本室浮尘 / 培养皿孢子。
// 纯 CSS，无 JS；尊重 prefers-reduced-motion。仅 transform/opacity。
const SPECK_COUNT = 44;
const specks = Array.from({ length: SPECK_COUNT }, (_, i) => {
  const x = (i * 37 + 11) % 100;
  const s = 2 + ((i * 13) % 3) * 1.2;        // 2.0 / 3.2 / 4.4 px
  const dur = 14 + ((i * 7) % 11);           // 14–24s
  const delay = -((i * 3.7) % dur);
  const drift = ((i % 2 === 0) ? 1 : -1) * (6 + (i % 5) * 4);
  const start = (i * 17 + 5) % 100;          // 全屏纵向分布
  const accent = i % 9 === 4;
  return { x, s, dur, delay, drift, start, accent };
});
---
<div class="d-specks" aria-hidden="true">
  {specks.map((p) => (
    <span
      class="speck"
      style={`--x:${p.x}%; --s:${p.s}px; --dur:${p.dur}s; --delay:${p.delay.toFixed(1)}s; --drift:${p.drift}px; --start:${p.start}%; ${p.accent ? '--c:var(--accent, #c2452d);' : ''}`}
    ></span>
  ))}
</div>

<style>
  .d-specks { position: relative; width: 100%; height: 100%; overflow: hidden; }
  .speck {
    position: absolute; top: var(--start); left: var(--x);
    width: var(--s); height: var(--s); border-radius: 50%;
    background: var(--c, var(--ink-soft, #7d766a));
    opacity: 0;
    animation: speckFloat var(--dur) linear infinite;
    animation-delay: var(--delay);
  }
  @keyframes speckFloat {
    0%   { transform: translate(0, 0) scale(.85);        opacity: 0; }
    16%  { opacity: .62; }
    68%  { opacity: .44; }
    100% { transform: translate(var(--drift), -190px) scale(1); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .speck { animation: none; opacity: .3; }
  }
</style>
